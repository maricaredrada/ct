# Flask / app
SECRET_KEY=replace-me
FLASK_DEBUG=1
DATABASE_PATH=data/logbook.db
DEBOUNCE_SECONDS=8

# Hardware mode: 1 for mock (Windows dev/tests), 0 for Raspberry Pi hardware
USE_MOCK_HARDWARE=1
AS608_PORT=/dev/serial0
AS608_BAUDRATE=57600
GREEN_LED_PIN=17
RED_LED_PIN=27
BUZZER_PIN=22

# Firebase Admin SDK (optional in local development)
FIREBASE_CREDENTIALS_FILE=/absolute/path/to/firebase-service-account.json
FIREBASE_PROJECT_ID=your-project-id
